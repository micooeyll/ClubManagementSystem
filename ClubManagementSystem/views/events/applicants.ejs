<!DOCTYPE html>
<html>

<head>

    <title>Applicants</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" type="image/favicon" href="/favicon.ico">
</head>

<body>
<%- include("../partials/navbar") %>
<div class="container mt-5">

    <h2 class="mb-4">

        Applicants - <%= event.title %>

    </h2>

    <a href="/events" class="btn btn-dark mb-3">
         Back to Events
    </a>

    <% if(event.Applications.length === 0){ %>

        <div class="alert alert-info">
            No applications for this event yet.
        </div>

    <% } else { %>

        <table class="table table-bordered table-hover">

            <thead class="table-dark">

                <tr>

                    <th>Name</th>

                    <th>Email</th>

                    <th>Status</th>

                </tr>

            </thead>

            <tbody>

                <% event.Applications.forEach(application => { %>

                    <tr>

                        <td>

                            <%= application.User.firstName %>
                            <%= application.User.lastName %>

                        </td>

                        <td>

                            <%= application.User.email %>

                        </td>

                        <td>

                            <% if(application.status === "Approved"){ %>

                                <span class="badge bg-success">
                                    Approved
                                </span>

                            <% } else if(application.status === "Rejected"){ %>

                                <span class="badge bg-danger">
                                    Rejected
                                </span>

                            <% } else { %>

                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>

                            <% } %>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    <% } %>

</div>

</body>

</html>