<!DOCTYPE html>
<html>

<head>

    <title>Events</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" type="image/png" href="/image/favicon.png">
</head>

<body>
    <%- include("../partials/navbar") %>
    
    <div class="container mt-5">

        <h2>Events</h2>
        <form action="/events" method="GET" class="row mb-4">

        <div class="col-md-10">
            <input
                type="text"
                class="form-control"
                name="search"
                placeholder="Search events..."
                value="<%= search %>">
        </div>

        <div class="col-md-2">
            <button class="btn btn-dark w-100"> Search </button>
        </div>

    </form>

        <% if(success){ %>
            <div class="alert alert-success alert-dismissible fade show">
         <%= success %>

        <button type="button" class="btn-close" data-bs-dismiss="alert">  </button>

    </div>

    <% } %>

    <% if(error){ %>
    <div class="alert alert-danger alert-dismissible fade show">
    <%= error %>

    <button type="button" class="btn-close" data-bs-dismiss="alert">  </button>

    </div>

    <% } %>

        <% if(role==="admin" ){ %>

            <a href="/events/create" class="btn btn-primary mb-3"> Add Event </a>

            <% } %>

                <table class="table table-bordered table-hover">

                    <thead class="table-dark">

                        <tr>
                            <th>Title</th>
                            <th>Club</th>
                            <th>Location</th>
                            <th>Date</th>
                            <th>Quota</th>
                            <th>Remaining</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        <% events.forEach(event=> { %>

                            <tr>

                                <td><%= event.title %></td>

                                <td><%= event.Club.name %></td>

                                <td><%= event.location %></td>

                                <td><%= new Date(event.eventDate).toLocaleString("tr-TR", {
                                    day: "2-digit",month: "2-digit",year: "numeric",
                                    hour: "2-digit",minute: "2-digit"}) %>
                                </td>

                                <td><%= event.quota %></td>

                                <td><% if(event.remaining> 0){ %>

                                        <span class="badge bg-success">
                                            <%= event.remaining %>
                                        </span>

                                        <% } else { %>

                                            <span class="badge bg-danger">
                                                Full
                                            </span>

                                            <% } %>
                                </td>

                                <td>

                                    <% if(role==="admin" ){ %>

                                        <a href="/events/edit/<%= event.id %>" class="btn btn-dark btn-sm">
                                             Edit
                                        </a>

                                        <form action="/events/delete/<%= event.id %>" method="POST"
                                            style="display:inline;">

                                            <button class="btn btn-dark btn-sm">
                                                 Delete
                                            </button>

                                        </form>

                                        <a href="/events/applicants/<%= event.id %>" class="btn btn-dark btn-sm">
                                            See Applicants
                                        </a>

                                        <% } else { %>

                                            <form action="/events/apply/<%= event.id %>" method="POST"
                                                style="display:inline;">

                                                <button class="btn btn-success btn-sm">
                                                    Apply
                                                </button>

                                            </form>

                                        <% } %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
    </div>
</body>

</html>