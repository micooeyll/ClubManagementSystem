<!DOCTYPE html>
<html>

<head>

    <title>Clubs</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" type="image/favicon" href="/favicon.ico">
</head>

<body>
<%- include("../partials/navbar") %>
<div class="container mt-5">

    <h2>Club List</h2>

    <form action="/clubs" method="GET" class="mb-3">

        <div class="input-group">

            <input
                type="text"
                name="search"
                class="form-control"
                placeholder="Search club..."
                value="<%= search %>">

            <button class="btn btn-primary">
                Search
            </button>

        </div>

    </form>

    <% if (role === "admin") { %>

    <a href="/clubs/create" class="btn btn-primary mb-3">
        Add Club
    </a>

    <% } %>

    <table class="table table-bordered">

        <thead>

            <tr>

                <th>ID</th>
                <th>Name</th>
                <th>Description</th>
                <% if (role === "admin") { %>
                    <th>Actions</th>
                <% } %>

            </tr>

        </thead>

        <tbody>

            <% clubs.forEach(club => { %>

            <tr>
                <td><%= club.id %></td>
                <td><%= club.name %></td>
                <td><%= club.description %></td>

                <% if (role === "admin") { %>
                    <td>
                        <a href="/clubs/edit/<%= club.id %>" class="btn btn-dark btn-sm">
                            Edit
                        </a>

                        <form action="/clubs/delete/<%= club.id %>" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-dark btn-sm">
                                    Delete
                                </button>
                            </form>
                        </td>
                        <% } %>
                    </tr>

                <% }) %>

        </tbody>

    </table>

</div>

</body>

</html>